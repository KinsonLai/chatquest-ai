{
  "name": "chatquest-ai",
  "version": "0.3.1",
  "description": "MCP server for text adventures with saved state, character knowledge, server dice and alternative timelines.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "chatquest": "src/cli.mjs",
    "branchwright": "src/cli.mjs"
  },
  "files": [
    "src",
    "examples",
    "skills",
    "docs",
    "README.md",
    "README.zh-TW.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/cli.mjs",
    "start:http": "node src/cli.mjs --http",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:package": "node scripts/smoke-package.mjs",
    "format:check": "prettier --check \"**/*.{mjs,json,md,yml}\"",
    "format": "prettier --write \"**/*.{mjs,json,md,yml}\""
  },
  "keywords": [
    "mcp",
    "text-adventure",
    "interactive-fiction",
    "rpg",
    "llm",
    "game-master",
    "sqlite",
    "branching-narrative"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KinsonLai/chatquest-ai.git"
  },
  "homepage": "https://github.com/KinsonLai/chatquest-ai",
  "bugs": {
    "url": "https://github.com/KinsonLai/chatquest-ai/issues"
  }
}
